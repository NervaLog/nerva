# /etc/jepsen/jepsen.env (read by jepsen.service; every line is optional).
# The tracker issue the nightly comments on once a day (a day without a comment is the alarm).
JEPSEN_TRACKER=
# The repository the issues and statuses go to.
#JEPSEN_GH_REPO=NervaLog/nerva
# Seconds of one run's --time-limit, and of the whole night (3 h).
#JEPSEN_TIME_LIMIT=3600
#JEPSEN_NIGHT_SECONDS=10800
