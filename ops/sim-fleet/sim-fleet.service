[Unit]
Description=Nerva simulation fleet (the VOPR and the fuzzers on fresh seeds at the tip of main)
Documentation=https://github.com/NervaLog/nerva/blob/main/ops/sim-fleet/README.md
After=network-online.target
Wants=network-online.target

[Service]
User=simfleet
Group=simfleet
WorkingDirectory=/var/lib/sim-fleet
EnvironmentFile=-/etc/sim-fleet/fleet.env
# systemd reads these as root and hands the service private copies under
# $CREDENTIALS_DIRECTORY; the service user cannot read /etc/sim-fleet itself. The deploy key is
# optional (a public repository is fetched over HTTPS without one).
LoadCredential=token:/etc/sim-fleet/token
LoadCredential=deploy-key:/etc/sim-fleet/deploy-key
ExecStart=/var/lib/sim-fleet/nerva/ops/sim-fleet/run.sh
Restart=always
RestartSec=30
Nice=10
# The loop has its own deadlines (run.sh); this bounds a hang of the shell itself.
TimeoutStopSec=60
# 64 GB host: the fleet may not take the last GBs from sshd and the journal. A seed the kernel
# kills for memory (137) is counted as the host's, not filed; the service goes on.
MemoryMax=56G
OOMPolicy=continue

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sim-fleet
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
