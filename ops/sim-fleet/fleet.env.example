# /etc/sim-fleet/fleet.env: settings of the simulation fleet. Every line is optional.
# The token is not here: it is the file /etc/sim-fleet/token (README.md).

# The issue that gets one comment per finished UTC day with the seeds run and the failures by
# issue. Without it the daily totals are counted but not posted.
SIM_FLEET_TRACKER=

# Where main is fetched from. A private repository needs the deploy key (README.md); a public
# one can use https://github.com/NervaLog/nerva instead.
SIM_FLEET_REMOTE=https://github.com/NervaLog/nerva.git
SIM_FLEET_GH_REPO=NervaLog/nerva

# Workers, one core and about 4 GB of RAM each. Empty: the smaller of every core but one (git,
# builds and the reporter) and (memory - 1 GiB) / SIM_FLEET_SEED_MEMORY_MB, at least 1. A
# 4-core, 8 GB host gets 1.
SIM_FLEET_WORKERS=
# RAM one seed may take, in MB: the peak seen in the first deploy (3.2 to 3.9 GB), rounded up.
SIM_FLEET_SEED_MEMORY_MB=4096
# The split. Empty: with 3 workers or more, an eighth each (at least one) to the testing state
# machine and the fuzzers, the rest to Nerva's state machine; with 1 or 2 workers, all are mixed
# workers that rotate through the kinds seed by seed (half of the seeds are Nerva's). 0 stops a
# kind. Setting any of the three kinds turns the automatic rotation off.
SIM_FLEET_WORKERS_MIXED=
SIM_FLEET_WORKERS_VOPR_NERVA=
SIM_FLEET_WORKERS_VOPR_TESTING=
SIM_FLEET_WORKERS_FUZZ=
# The fuzzers the fuzz workers rotate through (default: all sixteen fuzz.yml runs).
SIM_FLEET_FUZZERS=

# A round's length: workers start seeds for this long, then the round is reported.
SIM_FLEET_ROUND_SECONDS=900

# Deadlines in seconds: one VOPR seed, one fuzzer seed, the full-log replay of a correctness
# failure, git, a build (five binaries), one report.
SIM_FLEET_VOPR_SEED_TIMEOUT=600
SIM_FLEET_FUZZ_SEED_TIMEOUT=900
SIM_FLEET_REPLAY_TIMEOUT=1800
SIM_FLEET_GIT_TIMEOUT=300
SIM_FLEET_BUILD_TIMEOUT=3600
SIM_FLEET_REPORT_TIMEOUT=600

# The build caches (.zig-cache, ~/.cache/zig) are emptied before a build when together they pass
# this many MB.
SIM_FLEET_CACHE_MB=16384

# Leave empty in this file. A dry run (README.md) sets it on its own command line: it then uses
# its own checkout and state under /var/lib/sim-fleet/dry and files nothing.
SIM_FLEET_DRY_RUN=
