<!DOCTYPE html>
<html lang="en" class="h-full bg-surface-muted">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>{% block title %}Creator Vortex{% endblock %}</title>
    <link rel="stylesheet" href="/assets/css/output.css"/>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
</head>
<body class="h-full">
    <div class="min-h-full">
        <!-- Sidebar (fixed) -->
        <div class="fixed inset-y-0 left-0 z-50 w-64 bg-sidebar-bg">
            <div class="flex h-full flex-col">
                <!-- Logo -->
                <div class="flex h-16 shrink-0 items-center px-6 border-b border-sidebar-border">
                    <span class="text-xl font-bold text-white">Creator Vortex</span>
                </div>

                <!-- Org Switcher -->
                <div class="px-4 py-4 border-b border-sidebar-border">
                    <button type="button" class="flex w-full items-center gap-3 rounded-lg bg-sidebar-bg-hover px-3 py-2 text-left text-sm font-medium text-sidebar-text-active hover:bg-gray-700">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary-600 text-sm font-medium text-white">
                            {{ model.orgInitial | default('C') }}
                        </span>
                        <span class="flex-1 truncate">{{ model.orgName | default('My Organization') }}</span>
                        <svg class="h-5 w-5 shrink-0 text-sidebar-text" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                        </svg>
                    </button>
                </div>

                <!-- Navigation -->
                <nav class="flex-1 space-y-1 px-4 py-4 overflow-y-auto">
                    <!-- Home -->
                    <a href="/" class="sidebar-nav-item {{ model.currentPath == '/' ? 'sidebar-nav-item-active' : 'sidebar-nav-item-inactive' }}">
                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                        </svg>
                        Home
                    </a>

                    <!-- Surfaces -->
                    <a href="/surfaces" class="sidebar-nav-item {{ model.currentPath == '/surfaces' ? 'sidebar-nav-item-active' : 'sidebar-nav-item-inactive' }}">
                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 0 1 7.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 0 1 1.06 0Z" />
                        </svg>
                        Surfaces
                    </a>

                    <!-- Products -->
                    <a href="/products" class="sidebar-nav-item {{ model.currentPath == '/products' ? 'sidebar-nav-item-active' : 'sidebar-nav-item-inactive' }}">
                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
                        </svg>
                        Products
                    </a>

                    <!-- Entitlements -->
                    <a href="/entitlements" class="sidebar-nav-item {{ model.currentPath == '/entitlements' ? 'sidebar-nav-item-active' : 'sidebar-nav-item-inactive' }}">
                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 0 1 0 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 0 1 0-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375Z" />
                        </svg>
                        Entitlements
                    </a>

                    <!-- Audience -->
                    <a href="/audience" class="sidebar-nav-item {{ model.currentPath == '/audience' ? 'sidebar-nav-item-active' : 'sidebar-nav-item-inactive' }}">
                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                        </svg>
                        Audience
                    </a>

                    <!-- Activity -->
                    <a href="/activity" class="sidebar-nav-item {{ model.currentPath == '/activity' ? 'sidebar-nav-item-active' : 'sidebar-nav-item-inactive' }}">
                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
                        </svg>
                        Activity
                    </a>

                    <!-- Failures -->
                    <a href="/failures" class="sidebar-nav-item {{ model.currentPath == '/failures' ? 'sidebar-nav-item-active' : 'sidebar-nav-item-inactive' }}">
                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                        </svg>
                        Failures
                    </a>

                    <!-- Divider -->
                    <div class="my-4 border-t border-sidebar-border"></div>

                    <!-- Settings -->
                    <a href="/settings/org" class="sidebar-nav-item {{ model.currentPath == '/settings/org' ? 'sidebar-nav-item-active' : 'sidebar-nav-item-inactive' }}">
                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                        </svg>
                        Org Settings
                    </a>
                </nav>

                <!-- User (bottom) -->
                <div class="border-t border-sidebar-border p-4">
                    <div class="flex items-center gap-3">
                        <div class="h-8 w-8 rounded-full bg-primary-600 flex items-center justify-center text-sm font-medium text-white">
                            {{ model.userInitial | default('U') }}
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-sidebar-text-active truncate">{{ model.userName | default('User') }}</p>
                            <p class="text-xs text-sidebar-text truncate">{{ model.userEmail | default('user@example.com') }}</p>
                        </div>
                        <a href="/logout" class="text-sidebar-text hover:text-sidebar-text-active">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main content area -->
        <div class="pl-64">
            <!-- Top bar -->
            <header class="sticky top-0 z-40 bg-surface border-b border-border">
                <div class="flex h-16 items-center justify-between px-6">
                    <div class="flex items-center gap-4">
                        {% block breadcrumbs %}{% endblock %}
                        <div>
                            <h1 class="text-lg font-semibold text-text">{% block pageTitle %}Dashboard{% endblock %}</h1>
                            {% block pageSubtitle %}{% endblock %}
                        </div>
                    </div>
                    <div class="flex items-center gap-4">
                        <!-- Search (static) -->
                        <div class="relative">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                <svg class="h-4 w-4 text-text-subtle" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                                </svg>
                            </div>
                            <input type="text" placeholder="Search..." disabled class="input pl-9 w-64 bg-surface-muted cursor-not-allowed opacity-60" />
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page content -->
            <main class="page-container">
                {% block content %}{% endblock %}
            </main>
        </div>
    </div>
</body>
</html>
