{% extends "me/rename/views/layouts/PublicShell.peb" %}

{% block title %}Sign In - Creator Vortex{% endblock %}

{% block header %}
<h2 class="mt-6 text-center text-2xl font-bold text-text">Sign in to your account</h2>
<p class="mt-2 text-center text-sm text-text-muted">
    We'll email you a magic link.
</p>
{% endblock %}

{% block content %}
<div id="loginPanel">
    {% if model.sent %}
    <!-- Success Panel -->
    <div class="rounded-lg bg-success-50 p-4 ring-1 ring-inset ring-success-600/20">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-success-600" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <h3 class="text-sm font-medium text-success-700">Check your email</h3>
                <p class="mt-1 text-sm text-success-600">
                    We sent a magic link to your inbox. Click it to sign in.
                </p>
                <p class="mt-3">
                    <a href="/login" class="text-sm font-medium text-success-700 hover:text-success-600">
                        Didn't receive it? Try again &rarr;
                    </a>
                </p>
            </div>
        </div>
    </div>
    {% else %}
    <!-- Login Form -->
    {% if model.error %}
    <div class="mb-4 rounded-lg bg-error-50 p-4 ring-1 ring-inset ring-error-600/20">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-error-600" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <p class="text-sm text-error-700">{{ model.error }}</p>
            </div>
        </div>
    </div>
    {% endif %}

    <form method="POST" action="/login/send-link" class="space-y-6"
          hx-post="/login/send-link" hx-target="#loginPanel" hx-swap="outerHTML">
        <div>
            <label for="email" class="block text-sm font-medium text-text">
                Email address
            </label>
            <div class="mt-2">
                <input
                    type="email"
                    id="email"
                    name="email"
                    value="{{ model.email | default('') }}"
                    placeholder="you@example.com"
                    required
                    autocomplete="email"
                    class="input"
                />
            </div>
        </div>

        <div>
            <button type="submit" class="btn btn-primary w-full">
                Send magic link
            </button>
        </div>
    </form>

    <div class="mt-6">
        <div class="relative">
            <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-border"></div>
            </div>
            <div class="relative flex justify-center text-sm">
                <span class="bg-surface px-2 text-text-muted">Or</span>
            </div>
        </div>

        <div class="mt-6">
            <form method="POST" action="/login/demo">
                <button type="submit" class="btn btn-secondary w-full">
                    Continue as demo
                </button>
            </form>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
