{% extends "me/rename/views/layouts/AppShell.peb" %}

{% block title %}Home - Creator Vortex{% endblock %}

{% block pageTitle %}Home{% endblock %}

{% block content %}
<div class="space-y-6">
    <!-- Welcome Card -->
    <div class="card">
        <div class="flex items-center gap-4">
            <div class="h-12 w-12 rounded-full bg-primary-100 flex items-center justify-center">
                <svg class="h-6 w-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a14.926 14.926 0 0 1-5.841 2.58m-.119-8.54a6 6 0 0 0-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 0 0-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 0 1-2.448-2.448 14.9 14.9 0 0 1 .06-.312m-2.24 2.39a4.493 4.493 0 0 0-1.757 4.306 4.493 4.493 0 0 0 4.306-1.758M16.5 9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
                </svg>
            </div>
            <div>
                <h2 class="text-lg font-semibold text-text">Welcome back, {{ model.userName }}!</h2>
                <p class="text-sm text-text-muted">Here's what's happening with {{ model.orgName }}</p>
            </div>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="stat-tile">
            <dt class="stat-tile-label">Active Surfaces</dt>
            <dd class="stat-tile-value">3</dd>
        </div>
        <div class="stat-tile">
            <dt class="stat-tile-label">Products</dt>
            <dd class="stat-tile-value">5</dd>
        </div>
        <div class="stat-tile">
            <dt class="stat-tile-label">Total Audience</dt>
            <dd class="stat-tile-value">1,247</dd>
        </div>
        <div class="stat-tile">
            <dt class="stat-tile-label">Active Entitlements</dt>
            <dd class="stat-tile-value">892</dd>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card">
        <h3 class="text-base font-semibold text-text mb-4">Quick Actions</h3>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <a href="/surfaces" class="flex items-center gap-3 rounded-lg border border-border p-4 hover:bg-surface-muted transition-colors">
                <div class="h-10 w-10 rounded-lg bg-primary-100 flex items-center justify-center">
                    <svg class="h-5 w-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 0 1 7.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 0 1 1.06 0Z" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-medium text-text">Connect a Surface</p>
                    <p class="text-xs text-text-muted">Discord, Stripe, or more</p>
                </div>
            </a>
            <a href="/products" class="flex items-center gap-3 rounded-lg border border-border p-4 hover:bg-surface-muted transition-colors">
                <div class="h-10 w-10 rounded-lg bg-success-100 flex items-center justify-center">
                    <svg class="h-5 w-5 text-success-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-medium text-text">Create a Product</p>
                    <p class="text-xs text-text-muted">Define what you sell</p>
                </div>
            </a>
            <a href="/audience" class="flex items-center gap-3 rounded-lg border border-border p-4 hover:bg-surface-muted transition-colors">
                <div class="h-10 w-10 rounded-lg bg-warning-100 flex items-center justify-center">
                    <svg class="h-5 w-5 text-warning-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-medium text-text">View Audience</p>
                    <p class="text-xs text-text-muted">See your members</p>
                </div>
            </a>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="card">
        <h3 class="text-base font-semibold text-text mb-4">Recent Activity</h3>
        <div class="empty-state">
            <svg class="empty-state-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
            </svg>
            <h3 class="empty-state-title">No recent activity</h3>
            <p class="empty-state-description">Connect a surface to start seeing activity here.</p>
        </div>
    </div>
</div>
{% endblock %}
