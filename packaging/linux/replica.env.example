# A replica's settings: copy this to /etc/nerva/replica-<n>.env for the unit nerva@<n>, then
#   chown root:root and chmod 0600 it (it holds the cluster key).
# Lines are NAME=value, with no quotes and no spaces around the =.

# Every replica's host:port, comma-separated, in replica index order. The same on every replica.
NERVA_ADDRESSES=10.0.0.1:3001,10.0.0.2:3001,10.0.0.3:3001

# The key replicas prove to each other that they hold: at least 32 bytes, the same on every
# replica. Make one with: openssl rand -hex 32
# It is empty here on purpose: a replica started with it empty is refused (NRV-E0901), so a
# forgotten edit cannot start a cluster on a key that is published. Put your own key after the =.
NERVA_CLUSTER_KEY=

# This replica's data file, in /var/lib/nerva (the only place the unit may write). Create it
# first, as the nerva user (the full path: sudo and runuser may not search /usr/local/bin;
# /usr/bin/nerva when a package installed it): runuser -u nerva -- /usr/local/bin/nerva format --cluster=1 --replica=0 --replica-count=3 /var/lib/nerva/0.nerva
NERVA_DATA_FILE=/var/lib/nerva/0.nerva

# Extra `nerva start` flags, separated by spaces, for example --cache-grid=1GiB --statsd=8125.
# Leave it empty for none. Never --development in production.
NERVA_FLAGS=
