# A gateway's settings: copy this to /etc/nerva/api-<n>.env for the unit nerva-api@<n>, then
#   chown root:root and chmod 0600 it (it holds the gateway key).
# Lines are NAME=value, with no quotes and no spaces around the =.

# The cluster id the replicas were formatted with.
NERVA_CLUSTER=1

# Every replica's host:port, in replica index order, as in the replicas' env files.
NERVA_ADDRESSES=10.0.0.1:3001,10.0.0.2:3001,10.0.0.3:3001

# The key clients send in X-Nerva-Key. Make one with: openssl rand -hex 32
# It is empty here on purpose: a gateway started with it empty is refused (NRV-E0008), so a
# forgotten edit cannot open a gateway on a key that is published. Put your own key after the =.
NERVA_KEY=

# Where the gateway listens: loopback by default. The gateway speaks plain HTTP: put TLS in
# front of it (SECURITY.md) before listening on another address, and add --listen-remote
# to NERVA_FLAGS for that.
NERVA_LISTEN=127.0.0.1:8080

# Extra `nerva api` flags, separated by spaces, for example --statsd=127.0.0.1:8125
# --request-timeout=30000. Leave it empty for none.
NERVA_FLAGS=
